{
  "public_model_name": "my-model",
  "timeout_seconds": 120,
  "gateway_api_key_env": "GATEWAY_API_KEY",
  "routing": {
    "mode": "single",
    "backend": "api1"
  },
  "backends": {
    "api1": {
      "adapter": "openai",
      "url": "http://127.0.0.1:8001/v1/chat/completions",
      "headers_env": {
        "Authorization": "MODEL_API_KEY"
      },
      "header_prefixes": {
        "Authorization": "Bearer "
      },
      "overrides": {},
      "compatibility": {
        "metadata_values": "json_string",
        "drop_fields": []
      },
      "models_url": "http://127.0.0.1:8001/v1/models"
    },
    "api2": {
      "adapter": "template",
      "url": "http://127.0.0.1:8002/infer",
      "headers_env": {
        "X-API-Key": "CUSTOM_API_KEY"
      },
      "request_template": {
        "model_name": {
          "$ref": "model"
        },
        "input": {
          "history": {
            "$ref": "request.messages"
          }
        },
        "parameters": {
          "temperature": {
            "$ref": "request.temperature",
            "$default": 0.7
          },
          "max_new_tokens": {
            "$ref": "request.max_tokens",
            "$default": 1024
          }
        }
      },
      "response_content_path": "data.answer",
      "models_url": "http://127.0.0.1:8002/v1/models"
    }
  },
  "http_pool": {
    "max_idle_connections": 256,
    "max_idle_connections_per_host": 128,
    "max_connections_per_host": 0,
    "idle_timeout_seconds": 90
  }
}
