{
  "timeout_seconds": 1860,
  "discovery_timeout_seconds": 10,
  "model_cache_seconds": 60,
  "discovery_retry_seconds": 5,
  "routing": {
    "mode": "single",
    "backend": "dcu"
  },
  "management": {
    "enabled": true,
    "state_file": "/data4/aigate/state/management-state.json",
    "warmup_rounds": 2,
    "warmup_step_seconds": 120,
    "warmup_timeout_seconds": 900,
    "warmup_max_tokens": 1024,
    "drain_timeout_seconds": 1900,
    "auto_rollback": false,
    "failure_threshold": 3,
    "failure_window_seconds": 60,
    "rollback_retry_seconds": 60,
    "socket": "/data4/aigate/.aigate/control.sock"
  },
  "backends": {
    "dcu": {
      "adapter": "openai",
      "url": "http://127.0.0.1:10016/v1/chat/completions",
      "models_url": "http://127.0.0.1:10016/v1/models",
      "compatibility": {
        "metadata_values": "workspace_object_json_string",
        "drop_fields": []
      }
    }
  }
}
