{
  "timeout_seconds": 300,
  "gateway_api_key_env": "GATEWAY_API_KEY",
  "discovery_timeout_seconds": 10,
  "model_cache_seconds": 60,
  "discovery_retry_seconds": 5,
  "routing_file": "routing.json",
  "backends": {
    "api1": {
      "adapter": "openai",
      "url": "http://127.0.0.1:8001/v1/chat/completions",
      "headers_env": {},
      "compatibility": {
        "metadata_values": "json_string",
        "drop_fields": []
      },
      "models_url": "http://127.0.0.1:8001/v1/models"
    },
    "api2": {
      "adapter": "openai",
      "url": "http://127.0.0.1:8002/v1/chat/completions",
      "headers_env": {},
      "compatibility": {
        "metadata_values": "json_string",
        "drop_fields": []
      },
      "models_url": "http://127.0.0.1:8002/v1/models"
    }
  },
  "http_pool": {
    "max_idle_connections": 256,
    "max_idle_connections_per_host": 128,
    "max_connections_per_host": 0,
    "idle_timeout_seconds": 90
  }
}
