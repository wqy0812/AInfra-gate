[Unit]
Description=aigate switch entry %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aigate-switch
Group=aigate-switch
Environment="AIGATE_SWITCH_LISTEN=127.0.0.1:10015"
Environment="AIGATE_CONTROL_LISTEN=127.0.0.1:18083"
Environment="AIGATE_ALLOWED_CIDRS=127.0.0.0/8,::1/128"
EnvironmentFile=/etc/aigate/switch-%i.env
ExecStart=/usr/local/bin/aigate-switch serve --id %i --listen ${AIGATE_SWITCH_LISTEN} --control-listen ${AIGATE_CONTROL_LISTEN} --allowed-cidrs ${AIGATE_ALLOWED_CIDRS} --forward-timeout 62m --shutdown-timeout 62m
Restart=on-failure
RestartSec=5s
TimeoutStopSec=63min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
