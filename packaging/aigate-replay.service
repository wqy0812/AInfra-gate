[Unit]
Description=aigate replay control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Same account as the switch: recording files are 0600 and read in place.
User=aigate-switch
Group=aigate-switch
StateDirectory=aigate-replay
StateDirectoryMode=0700
Environment="AIGATE_REPLAY_LISTEN=127.0.0.1:18085"
Environment="AIGATE_REPLAY_ALLOWED_CIDRS=127.0.0.0/8,::1/128"
EnvironmentFile=/etc/aigate/replay.env
ExecStart=/usr/local/bin/aigate-replay serve --listen ${AIGATE_REPLAY_LISTEN} --allowed-cidrs ${AIGATE_REPLAY_ALLOWED_CIDRS} --record-root /var/lib/aigate-record --data-root /var/lib/aigate-replay --targets /etc/aigate/replay-targets.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/aigate-record
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
