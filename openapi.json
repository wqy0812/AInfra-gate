{
  "openapi": "3.0.3",
  "info": {
    "title": "aigate switch and independent proxy",
    "version": "3.0.0",
    "description": "Current split source contract; deployment is separately verified. Switch control APIs require authentication. Proxy policy is a local immutable file; there is no remote configuration write API. Replay runs only in platform task containers and exposes no HTTP listener. Path servers identify the owning listener."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway process health only",
        "responses": {
          "200": {
            "description": "Gateway is running"
          }
        },
        "security": []
      },
      "servers": [
        {
          "url": "http://127.0.0.1:10015",
          "description": "aigate-switch business listener; transparent forwarding"
        },
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        }
      ]
    },
    "/v1/models": {
      "get": {
        "summary": "Discover the active backend model with its actual ID",
        "security": [],
        "responses": {
          "200": {
            "description": "One active model with its discovered backend ID; successful downstream discovery is required"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "servers": [
        {
          "url": "http://127.0.0.1:10015",
          "description": "aigate-switch business listener; transparent forwarding"
        },
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        }
      ]
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Adapt and forward a chat request",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OpenAI chat completion or SSE stream preserves the backend body and model field, including a missing model field. Transport failures are sent as error data events, except when the observer has recognized [DONE] and it has been forwarded. This exception does not apply when observation limits prevent [DONE] recognition, and does not filter upstream data after [DONE]; observation does not rewrite upstream events.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Aigate-Backend": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Aigate-Route-Version": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Aigate-Model": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Aigate-Config-Digest": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Generation backend non-2xx responses preserve the original HTTP status and body, including non-JSON and empty bodies. Content-Type, Content-Encoding, Retry-After, WWW-Authenticate and Location are forwarded except hop-by-hop headers. X-Request-ID is generated by the gateway. Gateway-originated failures still use error.code/message/request_id; discovery and probes retain their existing error mapping."
          }
        },
        "description": "Switch forwards original request bytes; proxy alone discovers/replaces the model, applies compatibility/overrides and records observations. Accepted requests keep their target through uploads, upstream waits and the complete response. Upload limit 30,000,000 bytes/5 minutes. Switch forward-timeout defaults to 62 minutes including upload and client writes. Generation requests are not retried.",
        "parameters": [
          {
            "name": "X-Code-Eval-Token",
            "in": "header",
            "required": false,
            "description": "Switch-only platform test lease token, not business authentication. Omit for ordinary or direct proxy requests.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "servers": [
        {
          "url": "http://127.0.0.1:10015",
          "description": "aigate-switch business listener; transparent forwarding"
        },
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        }
      ]
    },
    "/openapi.json": {
      "servers": [
        {
          "url": "http://127.0.0.1:10015",
          "description": "aigate-switch business listener; transparent forwarding"
        },
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        }
      ],
      "get": {
        "security": [],
        "summary": "Read this combined contract",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/runtime/v1/status": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Read proxy identity, redacted local policy and inflight state",
        "description": "Available with profiling disabled; no authentication and no configuration writes. A CLI --check-config result uses this shape with empty boot_id and admission=false, without starting listeners, writing data or making network requests.",
        "responses": {
          "200": {
            "description": "Proxy process status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyStatus"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Router-owned Prometheus observations from the proxy",
        "description": "Includes traffic through every switch and direct proxy access. No duplicate profiling on switch. Requires local profile.enabled.",
        "responses": {
          "200": {
            "description": "Prometheus exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/v1/status": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Retained event range and observation health",
        "responses": {
          "200": {
            "description": "Profile source status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/v1/analyses": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "post": {
        "security": [],
        "summary": "Create a bounded observation analysis job",
        "description": "Read-only observation computation, not configuration publication; job submission does not indicate completion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "number",
                    "description": "UTC epoch seconds, positive"
                  },
                  "end": {
                    "type": "number",
                    "description": "Exclusive end, after start; window at most 24 hours"
                  },
                  "backend": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Analysis queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "description": "Requested observations outside retained range"
          },
          "429": {
            "description": "Analysis queue/cache capacity exceeded"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/v1/analyses/{id}": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Poll an analysis result",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queued/running/completed or failed job state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Missing or expired job"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/v1/stream-incidents": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Search bounded stream incident records",
        "description": "Write stalls describe proxy-to-connection-peer writes and do not prove final-client blockage. Legacy incident fields remain readable.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "UTC epoch seconds; trigger time window [start,end)"
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "UTC epoch seconds; trigger time window [start,end)"
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Records and opaque next cursor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StreamIncident"
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    },
                    "incomplete": {
                      "type": "boolean"
                    },
                    "window_partially_expired": {
                      "type": "boolean"
                    },
                    "dropped_total": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    },
                    "write_errors_total": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v3/status": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "get": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Read current and retiring switch snapshots",
        "responses": {
          "200": {
            "description": "Switch state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlStatus"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v3/commands": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "post": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Submit a switch control command",
        "description": "Prepare accepts only SwitchSnapshot. Validate checks proxy identity/config digest, then runs real discovery and protocol probes through the proxy.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v3/commands/{seq}": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "get": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Read an original command receipt without retrying the mutation",
        "parameters": [
          {
            "name": "seq",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Command receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v2/status": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "get": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Read fixed-runtime compatibility status (retiring counts only)",
        "responses": {
          "200": {
            "description": "Switch state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlStatus"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v2/commands": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "post": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Submit a fixed-runtime test command only",
        "description": "Only test-acquire/test-release/test-status; legacy prepare, publish and other control actions return legacy_command_removed. Shares sequence and receipts with v3.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyTestCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v2/commands/{seq}": {
      "servers": [
        {
          "url": "http://127.0.0.1:18083",
          "description": "aigate-switch authenticated control listener"
        }
      ],
      "get": {
        "security": [
          {
            "controlBearer": []
          }
        ],
        "summary": "Read an original command receipt without retrying the mutation",
        "parameters": [
          {
            "name": "seq",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Command receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/v1/stream-incidents/requests/{request_id}": {
      "servers": [
        {
          "url": "http://127.0.0.1:18084",
          "description": "aigate-proxy business listener; fixed Router adapter"
        },
        {
          "url": "http://127.0.0.1:18082",
          "description": "aigate-proxy optional observation listener"
        }
      ],
      "get": {
        "security": [],
        "summary": "Read retained incident request/response evidence",
        "description": "Metadata fixes a file snapshot. Content reads return Base64 bytes up to 256 KiB; offset and total_bytes count bytes. Only retained incident evidence is exposed; Cache-Control: no-store. No inference or timeline download.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "part",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "request",
                "response"
              ]
            },
            "description": "Omit for metadata and snapshot"
          },
          {
            "name": "snapshot",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Required for content; opaque value from metadata"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Required for content; zero-based byte offset"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "description": "Required for content"
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata: request_id, meta, files (request/response available and bytes), snapshot. Content: request_id, part, offset, next_offset, total_bytes, data (Base64)."
          },
          "400": {
            "description": "Invalid identifier or content parameters"
          },
          "404": {
            "description": "capture_not_retained: no retained files; recent captures may not be published yet"
          },
          "409": {
            "description": "Snapshot file replaced or shortened; refresh metadata"
          },
          "429": {
            "description": "Two concurrent reads already active"
          },
          "503": {
            "description": "Capture unavailable, unsafe, corrupt or read failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "AIGATE_CONTROL_KEY (minimum 32 bytes) plus actual TCP source CIDR allowlist; switch control APIs only."
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "messages"
        ],
        "additionalProperties": true,
        "properties": {
          "model": {
            "type": "string",
            "nullable": true,
            "description": "Ignored on input; downstream uses the discovered model. OpenAI responses preserve the backend model field without adding or replacing it."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "additionalProperties": true,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "content": {
                  "nullable": true,
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "temperature": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 2
          },
          "max_tokens": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          }
        }
      },
      "RuntimeCounts": {
        "type": "object",
        "properties": {
          "router_id": {
            "type": "string"
          },
          "binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "business": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "streams": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tests": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "probes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "description": "Instantaneous process counters; switch status contains one object per live snapshot. Proxy returns its own single counter object."
      },
      "ProxyStatus": {
        "type": "object",
        "required": [
          "service",
          "service_id",
          "router_id",
          "boot_id",
          "config_digest",
          "settings",
          "backend",
          "counts",
          "admission"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "aigate-proxy"
            ]
          },
          "service_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "router_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "boot_id": {
            "type": "string"
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true,
            "description": "Normalized local settings without credentials, listener or storage paths."
          },
          "backend": {
            "type": "object",
            "additionalProperties": true,
            "description": "Normalized fixed backend with header values/environment names and URL query strings removed."
          },
          "counts": {
            "$ref": "#/components/schemas/RuntimeCounts"
          },
          "admission": {
            "type": "boolean"
          }
        }
      },
      "StreamIncident": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "gateway_id": {
            "type": "string",
            "description": "Legacy field name; new proxy records contain service_id"
          },
          "router": {
            "type": "string"
          },
          "connection_peer": {
            "type": "string",
            "description": "Optional actual inbound peer IP:port. For switched traffic this is the switch, not necessarily the final client. Absent on old records."
          },
          "kind": {
            "type": "string",
            "enum": [
              "output_stall",
              "client_write_stall"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ongoing",
              "ended",
              "unknown"
            ]
          },
          "traffic": {
            "type": "string",
            "enum": [
              "replay"
            ],
            "description": "Present only for requests with a verified replay mark"
          }
        }
      },
      "SwitchSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "router_id",
          "router_version",
          "gateway_config_version",
          "binding_revision",
          "target_url",
          "config_digest"
        ],
        "properties": {
          "router_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "router_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "gateway_config_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Must exceed current binding revision"
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "description": "Proxy root URL with no credentials, query or fragment"
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "TestIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "token"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "writeOnly": true
          },
          "model": {
            "type": "string",
            "description": "Required for acquire"
          },
          "router_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "Required for acquire"
          },
          "binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Required for acquire"
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Optional for old clients; defaults to current binding digest. Explicit mismatch rejects acquire."
          }
        }
      },
      "ControlCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "operation_id",
          "gateway_id",
          "expected_boot_id",
          "command_seq",
          "expected_binding_revision",
          "action",
          "payload"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "enum": [
              3
            ]
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "expected_boot_id": {
            "type": "string"
          },
          "command_seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expected_binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "validate",
              "quiesce",
              "activate",
              "resume",
              "discard",
              "retire",
              "test-acquire",
              "test-release",
              "test-status",
              "record-start",
              "record-stop",
              "record-status",
              "record-pin",
              "record-unpin"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Action-specific: prepare=SwitchSnapshot; test-*=TestIdentity; activate={admission:boolean}; validate={rounds?,step_seconds?,timeout_seconds?,max_tokens?}; record-start=RecordingStart; record-stop/record-status={recording_id}; record-pin/record-unpin={recording_id,segment}; other actions={}. Unknown fields are rejected.",
            "additionalProperties": true
          }
        },
        "description": "Maximum body 1 MiB. One monotonically increasing sequence shared with v2 test compatibility, boot and binding checks, idempotent receipt for identical sequence/content."
      },
      "LegacyTestCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "operation_id",
          "gateway_id",
          "expected_boot_id",
          "command_seq",
          "expected_binding_revision",
          "action",
          "payload"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "enum": [
              2
            ]
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "expected_boot_id": {
            "type": "string"
          },
          "command_seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expected_binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "test-acquire",
              "test-release",
              "test-status"
            ]
          },
          "payload": {
            "$ref": "#/components/schemas/TestIdentity"
          }
        },
        "description": "Maximum body 1 MiB. One monotonically increasing sequence shared with v2 test compatibility, boot and binding checks, idempotent receipt for identical sequence/content."
      },
      "ControlResult": {
        "type": "object",
        "properties": {
          "command_seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ]
          },
          "error": {
            "type": "string"
          },
          "report": {
            "type": "object",
            "additionalProperties": true
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "recording": {
            "$ref": "#/components/schemas/RecordingSummary"
          }
        },
        "description": "HTTP 200 is a receipt, not proof of completion. Poll running validation by its original sequence; failed receipts contain error. record-start and record-pin/unpin complete asynchronously (running then completed/failed); record-stop and record-status return the session summary."
      },
      "ControlStatus": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "aigate-switch"
            ]
          },
          "protocol_version": {
            "type": "integer",
            "enum": [
              2,
              3
            ]
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "boot_id": {
            "type": "string"
          },
          "admission": {
            "type": "boolean"
          },
          "retired": {
            "type": "boolean"
          },
          "binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "last_command_seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "current": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "candidate": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "counts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeCounts"
            }
          },
          "counts_scope": {
            "type": "string",
            "enum": [
              "retiring_snapshots"
            ],
            "description": "Only present on v2 compatibility status; excludes the active snapshot, so it is not total load."
          },
          "test_occupancy": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "quiesce_owner": {
            "type": "string"
          },
          "business_read_header_timeout_seconds": {
            "type": "number"
          },
          "recording": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RecordingStatus"
              }
            ],
            "nullable": true,
            "description": "null when the switch runs without --record-root"
          }
        }
      },
      "RecordingStart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recording_id",
          "start_at",
          "end_at"
        ],
        "description": "A recording window. A start_at already past while end_at is ahead starts sampling immediately (used to re-send the rest of a window after a switch restart). One sampling or pending session per switch; a pending session may queue only behind a recording one that ends no later than its start. Schema 2 captures the complete request and response from the beginning, subject to the shared memory budget, and structured usage. Memory exhaustion explicitly marks truncated capture. The retired response field is rejected.",
        "properties": {
          "recording_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "schedule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, on the hour or half hour"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, on the hour or half hour"
          },
          "sample_one_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          },
          "max_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Session byte limit, at most --record-max-bytes (the default)"
          }
        }
      },
      "RecordingSummary": {
        "type": "object",
        "properties": {
          "recording_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "schedule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "preparing",
              "scheduled",
              "recording",
              "draining",
              "ended"
            ]
          },
          "end_reason": {
            "type": "string",
            "enum": [
              "completed",
              "stopped",
              "retired",
              "process_exit",
              "max_bytes",
              "capacity",
              "disk_failed",
              "end_unknown"
            ]
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, on the hour or half hour"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, on the hour or half hour"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "stopped_at": {
            "type": "string",
            "format": "date-time"
          },
          "sample_one_in": {
            "type": "integer"
          },
          "max_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "requests": {
            "type": "integer"
          },
          "recorded": {
            "type": "integer"
          },
          "dropped": {
            "type": "integer"
          },
          "truncated": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "inflight": {
            "type": "integer"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "segment": {
                  "type": "string",
                  "pattern": "^[0-9]{8}T[0-9]{2}(00|30)$",
                  "description": "UTC half-hour segment start, e.g. 20261012T1830"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "sealed"
                  ]
                },
                "coverage_start": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage_end": {
                  "type": "string",
                  "format": "date-time"
                },
                "partial": {
                  "type": "boolean"
                },
                "requests": {
                  "type": "integer"
                },
                "recorded": {
                  "type": "integer"
                },
                "dropped": {
                  "type": "integer"
                },
                "truncated": {
                  "type": "integer"
                },
                "bytes": {
                  "type": "integer",
                  "format": "int64"
                },
                "pinned": {
                  "type": "boolean"
                },
                "evicted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "RecordingStatus": {
        "type": "object",
        "properties": {
          "max_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "disk_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "pinned_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "memory_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "active_records": {
            "type": "integer"
          },
          "dropped": {
            "type": "integer"
          },
          "write_failures": {
            "type": "integer"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordingSummary"
            },
            "description": "Sessions not yet ended"
          }
        }
      }
    },
