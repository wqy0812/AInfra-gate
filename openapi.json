          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "expected_boot_id": {
            "type": "string"
          },
          "command_seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expected_binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "validate",
              "quiesce",
              "activate",
              "resume",
              "discard",
              "retire",
              "test-acquire",
              "test-release",
              "test-status"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Action-specific: prepare=SwitchSnapshot; test-*=TestIdentity; activate={admission:boolean}; validate={rounds?,step_seconds?,timeout_seconds?,max_tokens?}; other actions={}. Unknown fields are rejected.",
            "additionalProperties": true
          }
        },
        "description": "Maximum body 1 MiB. One monotonically increasing sequence shared with v2 test compatibility, boot and binding checks, idempotent receipt for identical sequence/content."
      },
      "LegacyTestCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
