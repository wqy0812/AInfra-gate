            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "writeOnly": true
          },
          "model": {
            "type": "string",
            "description": "Required for acquire"
          },
          "router_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "Required for acquire"
          },
          "binding_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Required for acquire"
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Optional for old clients; defaults to current binding digest. Explicit mismatch rejects acquire."
          }
        }
      },
      "ControlCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "operation_id",
          "gateway_id",
          "expected_boot_id",
          "command_seq",
          "expected_binding_revision",
          "action",
          "payload"
